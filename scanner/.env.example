VITE_API_URL=http://localhost:5000/api

# Identifies this kiosk device to the backend (see backend/middleware/kiosk.js
# and backend/.env.example's KIOSK_DEVICES). Leave both unset during initial
# setup/development — the backend accepts unauthenticated scanner requests
# until KIOSK_ENFORCE=true is set on it.
#
# VITE_KIOSK_TOKEN: this device's shared secret (must match one entry in the
#   backend's KIOSK_DEVICES, or its KIOSK_TOKEN for a single-site deployment).
# VITE_KIOSK_SITE_ID: the site this physical kiosk is deployed at. Once set,
#   the registration form skips the site picker and uses this automatically —
#   a kiosk lives at one place, it shouldn't have to ask.
VITE_KIOSK_TOKEN=
VITE_KIOSK_SITE_ID=
