VITE_API_URL=http://localhost:5000/api

# There is deliberately no kiosk token here, and no device to provision.
#
# Employees open this page on their own phones. There is no shared tablet to
# hold a secret, and a VITE_* variable would not be one anyway — Vite inlines
# those into the bundle at build time, so anyone could read it out of the page
# source.
#
# On first load the page generates a random id for that handset and stores it
# locally (src/utils/device.js). It is not a credential: it exists so one
# phone cannot hold two people clocked in at once, and so "eleven people
# scanned from this device today" is visible to HR.
#
# Access is gated by the face and by GPS, server-side.
# See src/utils/device.js and backend/middleware/kiosk.js.
