VITE_API_URL=http://localhost:5000/api

# There is deliberately no kiosk token here.
#
# Vite inlines VITE_* variables into the JavaScript bundle at build time, so a
# token set here would ship to every visitor and could be read straight out of
# the page source — obfuscation, not authentication.
#
# Each tablet is instead provisioned once by opening a setup link:
#
#   https://<kiosk-url>/?setup=<token>&site=<siteId>
#
# The credentials are stored in that device's own localStorage and the query
# string is scrubbed from the address bar. A visitor who merely finds the
# kiosk URL gets the "device not set up" screen and can go no further.
# See src/utils/device.js and backend/middleware/kiosk.js.
