PORT=5000
MONGODB_URI=mongodb://localhost:27017/radiance
JWT_SECRET=replace-with-a-long-random-string-openssl-rand-hex-48
ML_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SCANNER_URL=http://localhost:5173

# Required in production. HMACs Aadhaar/national ID numbers before storage —
# the plaintext number is never stored, only this keyed hash plus the last 4
# digits. Generate with: openssl rand -hex 32
# Rotating this orphans every existing employee's ID lookup, so treat it like
# JWT_SECRET: set it once, back it up, don't change it casually.
NATIONAL_ID_HMAC_SECRET=replace-with-a-long-random-string-openssl-rand-hex-32

# Shared secret the backend sends to the ML service on every request (as the
# X-ML-Token header). Must match ML_SERVICE_TOKEN in ml-service's own env.
# Leave both unset for local development; set both before deploying, or the
# face-recognition service is reachable by anyone who finds its URL.
ML_SERVICE_TOKEN=

# There are deliberately no kiosk device tokens.
#
# Employees clock in from their own phones, so there is no fixed device to
# authenticate and no secret worth distributing — a token handed to 4,000
# people is not a token. The scanner URL is public by design.
#
# What actually gates a clock-in:
#   * the face must match an enrolled, HR-approved employee
#   * the phone's GPS must fall inside a site's geofence
#   * self-registration lands in PENDING_APPROVAL until HR confirms it
#
# The site each scan belongs to is derived from the coordinates
# (backend/utils/siteResolver.js), which is what keeps face matching scoped
# to ~200 candidates rather than all 4,000.

# Set to the number of reverse-proxy hops in front of this server in
# production (Render/Vercel/nginx/Cloudflare = 1). Required for rate
# limiting and IP logging to work correctly once deployed — without it,
# express-rate-limit rejects every request that carries an X-Forwarded-For
# header. Safe to leave at the default (1) for most single-proxy setups.
TRUST_PROXY=1

# Set to true only if the dashboard and this API are deployed on genuinely
# different domains (not just different ports/subdomains of the same
# domain) — e.g. a Vercel-hosted dashboard calling a Render-hosted API.
# Leave unset/false for same-site deployments (including local dev).
COOKIE_CROSS_SITE=false

# The timezone attendance, shift comparisons and the daily digest are
# computed in. Every date/time in the system is anchored to this regardless
# of what timezone the server itself runs in.
APP_TIMEZONE=Asia/Kolkata

# Optional — used only by create-admin.js (first-run seed script). Leave
# unset and it generates + prints a random one-time password instead of
# using a hardcoded default.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional — email notifications (spoof alerts, daily late/absent digest).
# Leave unset to skip notifications entirely (safe no-op, just logs to console).
# Works with Gmail's free SMTP tier: smtp.gmail.com, port 587, an "app password"
# (not your regular Gmail password) — https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# How many manual supervisor overrides (see POST /attendance/override) one
# employee may use per calendar month before HR has to intervene. Keeps the
# fallback from quietly becoming the norm for one person's ongoing
# recognition problem.
OVERRIDE_MONTHLY_LIMIT=3
